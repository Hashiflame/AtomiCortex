# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.pytest_cache/

# Virtual environment
.venv/
venv/
env/

# Environment variables 
.env

# Data 
data/
logs/
*.log

# ML модели
*.pkl
# ...except the promoted production bundles: they are the artifact the
# VM pulls, and models/ is not an ignored directory, so this negation
# actually takes effect (one inside data/ would not).
!models/prod/*.pkl
*.joblib
*.model
mlruns/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Nautilus
backtests/

.claude/
# Local snapshots (DB, models, .env) — never in git
backups/

# Рабочие файлы сессий (артефакты ревью, выгрузки) — чистятся вручную
tmp/*
!tmp/.gitkeep
