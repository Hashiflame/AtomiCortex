[Unit]
Description=AtomiCortex Trading Bot
Documentation=https://github.com/Hashiflame/AtomiCortex
After=network-online.target redis.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hashiflame
Group=hashiflame
WorkingDirectory=/home/hashiflame/AtomiCortex
Environment=PATH=/home/hashiflame/AtomiCortex/.venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/hashiflame/AtomiCortex/.env
# matplotlib (pulled by mlflow) needs a writable cache dir under ProtectHome=read-only
Environment=MPLCONFIGDIR=/home/hashiflame/AtomiCortex/data/.matplotlib
Environment=MPLBACKEND=Agg
Environment=TMPDIR=/home/hashiflame/AtomiCortex/data/tmp
# --mode paper: testnet is unusable here — BINANCE_TESTNET_* are empty by
# design, so build_node() would raise on every start.  paper resolves keys
# through the mainnet branch, which is what gives the 4H model real market
# data, and it matches TRADING_MODE=paper in .env.
# --dry-run: the only thing standing between "paper" and real mainnet
# orders.  Removing it is refused at startup (exit 78).
ExecStart=/home/hashiflame/AtomiCortex/.venv/bin/python \
    scripts/run_live.py \
    --mode paper \
    --dry-run \
    --symbols BTCUSDT-PERP \
    --capital 10000 \
    --log-level INFO

# Restart policy
Restart=on-failure
RestartSec=30
# 78 = _EXIT_CONFIG_ERROR in scripts/run_live.py (EX_CONFIG). A refusal by
# the fail-closed guard is not retryable: fail once instead of consuming the
# whole restart budget declared in [Unit] and leaving it exhausted.
RestartPreventExitStatus=78

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# mlruns is prefixed with '-': it is empty and cannot be tracked by git, so a
# fresh clone has no such directory and systemd 255 would abort the unit with
# 226/NAMESPACE before exec — a failure with zero application output.
# logs and data stay unprefixed: their absence MUST be fatal.
ReadWritePaths=/home/hashiflame/AtomiCortex/logs /home/hashiflame/AtomiCortex/data -/home/hashiflame/AtomiCortex/mlruns

# Resource limits
LimitNOFILE=65536
MemoryMax=4G

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atomicortex-bot

[Install]
WantedBy=multi-user.target
